# GCP Configuration
GCP_PROJECT_ID=yt-extension-backend-507011
PORT=8080

# Shopify Webhook Secret (Found in Shopify Admin > Settings > Notifications > Webhooks)
SHOPIFY_WEBHOOK_SECRET=your_shopify_webhook_secret_here

# Admin API Key for generating manual licenses via CLI
ADMIN_API_KEY=your_secure_admin_api_key_here

# License Policy
MAX_DEVICES_PER_LICENSE=1
